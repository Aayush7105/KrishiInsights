# ==============================================================================
# KrishiInsights Environment Configuration Template (.env.example)
# Copy this file to '.env' (in the project root) and 'backend/.env'.
# DO NOT COMMIT ACTUAL PASSWORDS OR CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Application Metadata
PROJECT_NAME="KrishiInsights API"
PROJECT_VERSION="0.1.0"
API_PREFIX="/api"
PORT=8000
HOST="127.0.0.1"

# Frontend Configuration (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:8000"

# ------------------------------------------------------------------------------
# Primary Database: Shared Neon Serverless PostgreSQL (AWS us-east-1)
# Project ID: morning-glitter-97393312 | Database: neondb | Branch: production
# ------------------------------------------------------------------------------
# 1. Pooled Connection (Used by FastAPI & SQLAlchemy runtime operations)
DATABASE_URL=postgresql+psycopg2://<username>:<password>@ep-blue-queen-bbr4u26m-pooler.c-15.us-east-1.aws.neon.tech/neondb?sslmode=require

# 2. Direct / Unpooled Connection (Used for Alembic migrations and schema management)
DATABASE_URL_DIRECT=postgresql+psycopg2://<username>:<password>@ep-blue-queen-bbr4u26m.c-15.us-east-1.aws.neon.tech/neondb?sslmode=require

# Neon Project Context
NEON_PROJECT_ID="morning-glitter-97393312"
NEON_ORG_ID="org-steep-leaf-69533238"
NEON_BRANCH="production"

# ------------------------------------------------------------------------------
# Legacy Local Backup Reference (For offline testing only - DO NOT USE IN PROD)
# ------------------------------------------------------------------------------
# LOCAL_BACKUP_DATABASE_URL=postgresql+psycopg2://krishiinsights_user:<password>@localhost:5432/krishiinsights_db
